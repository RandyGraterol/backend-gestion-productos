# ============================================
# InventarioApp Backend - Production Environment
# ============================================

# Server
NODE_ENV=production
PORT=3010
HOST=0.0.0.0

# Database (PostgreSQL for production)
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=inventario_db
DB_USER=inventario_user
DB_PASSWORD=inventario_secure_2026
DB_SSL=false
DB_SYNC=false
DB_FORCE_SYNC=false
DB_LOGGING=false

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-key-min-32-chars-long-change-this
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:8080,https://administracionurbantaxis.com

# Security
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15
HELMET_ENABLED=true

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=info
DB_LOGGING=false

# API
API_PREFIX=/api

# ============================================
# Email - Envío de códigos de un solo uso (OTP)
# para validar correos en la descarga de la app
# ============================================
# En producción debe estar en true para que los usuarios reciban sus códigos
EMAIL_ENABLED=false

# Servidor SMTP. Gmail: smtp.gmail.com puerto 587 (TLS) o 465 con EMAIL_SECURE=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# >>> SOLO ESTAS DOS VARIABLES DEBES COMPLETAR <<<
# Correo que enviará los códigos de un solo uso
EMAIL_USER=tucorreo@gmail.com
# Contraseña de aplicación (App Password), NO la contraseña normal del correo.
# Gmail: myaccount.google.com -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
EMAIL_PASSWORD=

# Remitente visible en los correos (debe coincidir con EMAIL_USER en Gmail)
EMAIL_FROM="Inventario Santiago <tucorreo@gmail.com>"


# ============================================
# Cloudinary (almacenamiento de imágenes de productos)
# Activar solo si el admin selecciona Cloudinary como proveedor
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
