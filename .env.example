# ============================================
# InventarioApp Backend - Environment Variables
# ============================================

# Server
NODE_ENV=production
PORT=3010
HOST=0.0.0.0

# ============================================
# Database Configuration
# ============================================
# Dialect: 'postgres' for production, 'sqlite' for development
DB_DIALECT=postgres

# PostgreSQL (when DB_DIALECT=postgres)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=inventario_db
DB_USER=inventario_user
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# SQLite (when DB_DIALECT=sqlite)
DB_PATH=./database/inventory.sqlite

# Database sync (disable in production, use migrations)
DB_SYNC=false
DB_FORCE_SYNC=false
DB_LOGGING=false

# ============================================
# Redis Configuration
# ============================================
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL (seconds)
REDIS_TTL_STATS=300
REDIS_TTL_DASHBOARD=120
REDIS_TTL_PRODUCTS=60

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-key-min-32-chars-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:8080,https://administracionurbantaxis.com

# ============================================
# Security
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15
HELMET_ENABLED=true

# ============================================
# File Upload
# ============================================
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3010
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# ============================================
# Email - Envío de códigos de un solo uso (OTP)
# para validar correos en la descarga de la app
# ============================================
# true  = envía los códigos por correo real (SMTP)
# false = los códigos se imprimen en la consola del servidor
EMAIL_ENABLED=false

# Servidor SMTP. Gmail: smtp.gmail.com puerto 587 (TLS) o 465 con EMAIL_SECURE=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# >>> SOLO ESTAS DOS VARIABLES DEBES COMPLETAR <<<
# Correo que enviará los códigos de un solo uso
EMAIL_USER=tucorreo@gmail.com
# Contraseña de aplicación (App Password), NO la contraseña normal del correo.
# Gmail: myaccount.google.com -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
EMAIL_PASSWORD=

# Remitente visible en los correos (debe coincidir con EMAIL_USER en Gmail)
EMAIL_FROM="Inventario Santiago <tucorreo@gmail.com>"

# ============================================
# Notifications
# ============================================
NOTIFICATIONS_ENABLED=true
EXPIRY_WARNING_DAYS=7
LOW_STOCK_THRESHOLD=20

# ============================================
# Session
# ============================================
SESSION_INACTIVITY_TIMEOUT=180000

# ============================================
# Frontend
# ============================================
FRONTEND_URL=http://localhost:8080
API_PREFIX=/api
API_VERSION=v1

# ============================================
# Backup (Optional)
# ============================================
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_INTERVAL=24
