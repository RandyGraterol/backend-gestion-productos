# ============================================
# Docker Compose - Variables de Entorno
# Copia como .env junto al docker-compose.yml
# Docker Compose sustituye ${VAR} con estos valores
# ============================================

# ── Database ──
DB_PASSWORD=inventario_tu_password_seguro_aqui

# ── JWT ──
JWT_SECRET=genera_una_clave_larga_de_minimo_32_caracteres_aqui

# ── Email (opcional) ──
EMAIL_ENABLED=false
# EMAIL_USER=tu@gmail.com
# EMAIL_PASSWORD=tu_contraseña_de_aplicación
# EMAIL_FROM=Inventario <noreply@tu-dominio.com>
