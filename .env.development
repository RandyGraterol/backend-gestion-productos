# ============================================
# ⚠️ SOLO REFERENCIA — ESTE ARCHIVO NO SE CARGA
#
# - Con Docker: las variables se definen en docker-compose.dev.yml
#   y sus valores se leen desde el archivo ".env" (raíz del backend).
# - Sin Docker (local): el backend carga ".env" (raíz del backend).
#
# Este archivo existe únicamente como documentación de ejemplo.
# ============================================
# InventarioApp Backend - Development Environment
# ============================================

# Server
NODE_ENV=development
PORT=3010
HOST=0.0.0.0

# Database (SQLite for development)
DB_DIALECT=sqlite
DB_PATH=./database/inventory.sqlite
DB_SYNC=true
DB_FORCE_SYNC=false
DB_LOGGING=false

# Redis (disabled in development)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=dev-secret-key-change-this-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:8080,http://localhost:19006

# Security
RATE_LIMIT_ENABLED=false
HELMET_ENABLED=true

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL=debug
DB_LOGGING=false

# API
API_PREFIX=/api

# ============================================
# Email - Envío de códigos de un solo uso (OTP)
# para validar correos en la descarga de la app
# ============================================
# true  = envía los códigos por correo real (SMTP)
# false = los códigos se imprimen en la consola del servidor (modo desarrollo)
EMAIL_ENABLED=false

# Servidor SMTP. Gmail: smtp.gmail.com puerto 587 (TLS) o 465 con EMAIL_SECURE=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# >>> SOLO ESTAS DOS VARIABLES DEBES COMPLETAR <<<
# Correo que enviará los códigos de un solo uso
EMAIL_USER=1nv3ntarioapp@gmail.com
# Contraseña de aplicación (App Password), NO la contraseña normal del correo.
# Gmail: myaccount.google.com -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
EMAIL_PASSWORD=gyvewwbqcmnpypys

# Remitente visible en los correos (debe coincidir con EMAIL_USER en Gmail)
EMAIL_FROM="Software Inventario <1nv3ntarioapp@gmail.com>"
