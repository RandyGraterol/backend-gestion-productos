{
  "name": "inventory-backend-api",
  "version": "1.0.0",
  "description": "Backend API for Inventory Control System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && node scripts/post-build.js",
    "start": "node dist/server.js",
    "test": "jest",
    "create-admin": "ts-node src/scripts/createAdmin.ts",
    "create-admin-simple": "ts-node src/scripts/createAdminSimple.ts",
    "seed": "ts-node src/scripts/seedDatabase.ts",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "migrate:expiry": "ts-node src/scripts/run-migration.ts",
    "migrate:ip-vpn": "ts-node src/scripts/migrate-ip-vpn-fields.ts",
    "migrate:all": "ts-node src/scripts/run-all-migrations.ts",
    "migrate:stock-items": "ts-node src/scripts/run-stock-movement-items-migration.ts",
    "backfill:rates": "ts-node src/scripts/backfillExchangeRates.ts",
    "clean:db": "ts-node src/scripts/cleanDatabase.ts",
    "migrate:postgres": "ts-node src/scripts/migrate-to-postgres.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose down && docker-compose build --no-cache && docker-compose up -d",
    "docker:restart": "docker-compose restart backend",
    "docker:shell": "docker exec -it inventario-backend sh",
    "docker:seed": "docker exec inventario-backend node dist/scripts/seedDatabase.js",
    "dev:up": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:down": "docker-compose -f docker-compose.dev.yml down",
    "dev:build": "docker-compose -f docker-compose.dev.yml build --no-cache",
    "dev:rebuild": "docker-compose -f docker-compose.dev.yml down && docker-compose -f docker-compose.dev.yml build --no-cache && docker-compose -f docker-compose.dev.yml up -d",
    "dev:logs": "docker-compose -f docker-compose.dev.yml logs -f backend",
    "dev:logs:all": "docker-compose -f docker-compose.dev.yml logs -f",
    "dev:restart": "docker-compose -f docker-compose.dev.yml restart backend",
    "dev:shell": "docker exec -it inventario-backend sh",
    "dev:seed": "docker exec inventario-backend npx ts-node src/scripts/seedDatabase.ts",
    "dev:seed:admin": "docker exec inventario-backend npx ts-node src/scripts/seedAdmin.ts",
    "dev:create-admin": "docker exec inventario-backend npx ts-node src/scripts/createAdmin.ts",
    "dev:clean": "docker exec inventario-backend npx ts-node src/scripts/cleanDatabase.ts"
  },
  "keywords": [
    "inventory",
    "api",
    "express",
    "typescript"
  ],
  "author": "Randy Graterol",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "sequelize": "^6.35.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
