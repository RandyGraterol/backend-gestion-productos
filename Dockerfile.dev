# ============================================
# InventarioApp Backend - Dockerfile (DESARROLLO)
# ts-node + nodemon + hot reload
# ============================================

FROM node:20-alpine

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Copy package files and install ALL dependencies
COPY package*.json ./
RUN npm ci

# Copy source code
COPY tsconfig.json ./
COPY src/ ./src/

# Create necessary directories
RUN mkdir -p uploads backups logs database

# Copy entrypoint script for dev
COPY entrypoint.dev.sh ./entrypoint.dev.sh
RUN chmod +x ./entrypoint.dev.sh

# Expose port
EXPOSE 3010

# Entrypoint: run migrations then start dev server
ENTRYPOINT ["dumb-init", "--", "./entrypoint.dev.sh"]

# Start with nodemon for hot reload
CMD ["npx", "nodemon", "--exec", "ts-node", "src/server.ts"]
